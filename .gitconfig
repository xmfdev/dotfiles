[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	dark = true
    side-by-side = true
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[pager]
	log = less
	branch = less

